      "routeKeys": {},
      "namedRegex": "^/dashboard/leaves(?:/)?$"
    },
    {
      "page": "/dashboard/my-workspace",
      "regex": "^/dashboard/my\\-workspace(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/my\\-workspace(?:/)?$"
    },
    {
      "page": "/dashboard/postings",
      "regex": "^/dashboard/postings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/postings(?:/)?$"
    },
    {
      "page": "/dashboard/settings",
      "regex": "^/dashboard/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/settings(?:/)?$"
    },
    {
      "page": "/dashboard/shifts",
      "regex": "^/dashboard/shifts(?:/)?$",
