{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FingerprintMatcher": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "Fingerprint": {
    "DefaultThreshold": 20.0,
    "MinimumMinutiae": 10,
    "MaxImageSize": 10485760
  }
