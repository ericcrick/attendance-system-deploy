# Template for deploy/postgres.env on the TARGET machine (referenced by
# docker-stack.yml's `env_file:` for the postgres service). Copy this to
# deploy/postgres.env and fill in a real password - gitignored, created
# once, never touched by updates.
#
# POSTGRES_PASSWORD here MUST be the same value as DB_PASSWORD in
# deploy/backend.env - same credential, split across two files because
# each Swarm service's env_file only applies to that one service.
#
# POSTGRES_USER/POSTGRES_DB here must match DB_USERNAME/DB_NAME in
# backend.env too - these three vars are what the official postgres image
# uses to auto-create the user/database the very first time this volume
# is initialized.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_generate_a_real_password
POSTGRES_DB=attendance_system
