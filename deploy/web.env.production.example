# This is NOT something you configure on the target machine — it's baked
# into the web app's compiled JavaScript on the DEV MACHINE, at build time,
# before it ever gets shipped anywhere. See deploy/README.md, "Two kinds of
# .env file", for why that's different from backend/.env.
#
# If you want to change these values, edit web/.env.production (in the
# source repo, gitignored, same idea as web/.env.local for dev), then run
# deploy/publish.ps1 again to rebuild and re-publish.

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_KIOSK_ID=HIS-Station-01
