# Template for backend/.env on the TARGET machine. Copy this to backend/.env
# inside the deploy repo clone and fill in real values — this example file
# has no secrets and is safe to commit; the real backend/.env is gitignored
# and stays local to that machine (target-setup.ps1 does this copy for you
# on first-time setup; it is never overwritten by later `git pull`s).

# Database Configuration — native PostgreSQL install, default port 5432
# (NOT 5433 — that was only the docker-compose host-port mapping)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=attendance_app
DB_PASSWORD=REPLACE_ME_generate_a_real_password
DB_NAME=attendance_system

# JWT Configuration — generate real random values, do not reuse across environments
JWT_SECRET=REPLACE_ME_openssl_rand_-base64_48
JWT_EXPIRATION=24h

# Application Configuration
PORT=3000
NODE_ENV=production

# API Configuration
API_PREFIX=api/v1

# CORS Configuration — Caddy proxies web+api under one origin, so normal
# browser traffic is same-origin and doesn't need this. Leave permissive
# unless something calls the API directly, cross-origin.
CORS_ORIGIN=*

# Fingerprint Device Configuration
FINGERPRINT_DEVICE_TYPE=DIGITAL_PERSONA
USE_SOURCEAFIS_MATCHER=true
FINGERPRINT_MATCHER_URL=http://localhost:5000/api/fingerprint
SOURCEAFIS_THRESHOLD=30
FINGERPRINT_MATCH_THRESHOLD=85

# ZKTeco Device Configuration — only add these if you ever switch
# FINGERPRINT_DEVICE_TYPE to ZKTECO. Left out entirely for now since we're
# not using a ZKTeco terminal — code falls back to safe defaults if unset.
# ZKTECO_DEVICE_IP=192.168.1.201
# ZKTECO_DEVICE_PORT=4370
# ZKTECO_DEVICE_PASSWORD=
