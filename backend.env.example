# Template for deploy/backend.env on the TARGET machine (referenced by
# docker-stack.yml's `env_file:` for the backend service). Copy this to
# deploy/backend.env next to docker-stack.yml and fill in real values -
# this example has no secrets and is safe to commit. The real backend.env
# stays local to that machine, gitignored, created once and left alone.

# Postgres is a Swarm service now too (see docker-stack.yml) - reached by
# its service name over the Swarm-internal network, not "localhost" (that
# would mean "this container itself" here) and not a real IP/hostname.
# DB_PASSWORD here MUST match POSTGRES_PASSWORD in deploy/postgres.env -
# same credential, two files because docker-stack.yml's `env_file:` is
# per-service.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_ME_generate_a_real_password
DB_NAME=attendance_system

# JWT Configuration - generate real random values, do not reuse across environments
JWT_SECRET=REPLACE_ME_openssl_rand_-base64_48
JWT_EXPIRATION=24h

# Application Configuration
PORT=3000
NODE_ENV=production

# API Configuration
API_PREFIX=api/v1

# CORS Configuration - Caddy proxies web+api under one origin, so normal
# browser traffic is same-origin and doesn't need this. Leave permissive
# unless something calls the API directly, cross-origin.
CORS_ORIGIN=*

# Fingerprint Device Configuration
FINGERPRINT_DEVICE_TYPE=DIGITAL_PERSONA
USE_SOURCEAFIS_MATCHER=true
# fingerprint-matcher is a separate Swarm service now, not localhost -
# reached by its service name over the Swarm-internal network.
FINGERPRINT_MATCHER_URL=http://fingerprint-matcher:5000/api/fingerprint
SOURCEAFIS_THRESHOLD=30
FINGERPRINT_MATCH_THRESHOLD=85

# ZKTeco Device Configuration - only add these if you ever switch
# FINGERPRINT_DEVICE_TYPE to ZKTECO. Left out for now since we're not
# using a ZKTeco terminal - code falls back to safe defaults if unset.
# ZKTECO_DEVICE_IP=192.168.1.201
# ZKTECO_DEVICE_PORT=4370
# ZKTECO_DEVICE_PASSWORD=
